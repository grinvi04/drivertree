NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# 사이트 공개 URL — OG 태그·공유 링크 생성 시 사용
# 로컬: http://localhost:3000  /  운영(Vercel): https://drivertree.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
